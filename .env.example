# Copy to .env and fill values. Do not commit real secrets.

# --- RAG thresholds / PDF chunking ---
MIN_CHUNK_DISTANCE=0.5
MAX_CONTEXT_LENGTH=70000
CHUNK_SIZE=100
CHUNK_OVERLAP=30

# --- Web ingest chunking (отдельно от PDF) ---
# Короткие Tavily-сниппеты (≤ WEB_CHUNK_SIZE слов) сохраняются одним чанком.
WEB_CHUNK_SIZE=300
WEB_CHUNK_OVERLAP=50

# --- Local LLM (use_local=true) — Ollama OpenAI-compatible ---
# Host (make run_app):  http://localhost:11434/v1
# Docker Compose:       http://ollama:11434/v1  (compose задаёт сам, не берите localhost)
# Endpoint: /v1/chat/completions (не /api/generate — это старый native API)
LLM_LOCAL_BASE_URL=http://localhost:11434/v1
LLM_LOCAL_API_KEY=
LLM_LOCAL_MODEL=qwen2.5:7b
# num_ctx: окно контекста Ollama (CPU 24GB → 4096..8192; больше = больше RAM)
LLM_LOCAL_NUM_CTX=8192
LLM_LOCAL_NUM_THREAD=8
LLM_LOCAL_TEMPERATURE=0.2
LLM_SYSTEM_PROMPT=Отвечай только на основе предоставленного контекста. Если в контексте нет ответа — скажи об этом.

# --- Remote LLM (use_local=false) — любой OpenAI-compatible ---
# OpenRouter:
LLM_REMOTE_BASE_URL=https://openrouter.ai/api/v1
LLM_REMOTE_API_KEY=sk-or-v1-xxxxxxxx
LLM_REMOTE_MODEL=openai/gpt-4o-mini
# Или OpenAI напрямую:
# LLM_REMOTE_BASE_URL=https://api.openai.com/v1
# LLM_REMOTE_API_KEY=sk-...
# LLM_REMOTE_MODEL=gpt-4o-mini
# Или Groq:
# LLM_REMOTE_BASE_URL=https://api.groq.com/openai/v1
# LLM_REMOTE_API_KEY=gsk_...
# LLM_REMOTE_MODEL=llama-3.3-70b-versatile
LLM_REMOTE_TEMPERATURE=0.2
LLM_REMOTE_HTTP_REFERER=http://localhost:3000
LLM_REMOTE_APP_TITLE=rag

# --- Web search (Tavily) ---
WEB_SEARCH_ENABLED=true
TAVILY_API_KEY=tvly-xxxxxxxxxxxxxxxx
TAVILY_MAX_RESULTS=3
TAVILY_SEARCH_DEPTH=basic
TAVILY_INCLUDE_RAW=true

# --- infra ---
# PG_HOST=localhost
# OLLAMA_EMBEDDING_URL=http://localhost:11434/api/embeddings
# OLLAMA_EMBEDDING_MODEL=bge-m3:latest
# SERVER_ADDR=:3000
